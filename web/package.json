{
  "name": "plasma-generator",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Classic plasma restorations and modern generative visuals in TypeScript + WebGL2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "yarn test:generator && yarn test:visual",
    "test:generator": "tsx scripts/verify-generator.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
